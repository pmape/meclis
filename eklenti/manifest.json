{
  "manifest_version": 3,
  "name": "Meclis Köprüsü",
  "version": "1.0.0",
  "description": "Meclis'in DeepSeek, Kimi, ChatGPT, Grok, Gemini ve Claude sitelerini senin açık oturumunla kullanmasını sağlar.",
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://www.kimi.com/*",
    "https://kimi.com/*",
    "https://chatgpt.com/*",
    "https://grok.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*"
  ],
  "background": { "service_worker": "arkaplan.js" },
  "content_scripts": [
    {
      "matches": ["https://pmape.github.io/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["kopru.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://www.kimi.com/*",
        "https://kimi.com/*",
        "https://chatgpt.com/*",
        "https://grok.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*"
      ],
      "js": ["site.js"],
      "run_at": "document_idle"
    }
  ]
}
